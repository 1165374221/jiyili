{
  "name": "jiyili",
  "private": true,
  "version": "1.0.0",
  "description": "技毅力 —— 交换机命令行配置生成工具",
  "author": "JUZHU <1165374221@qq.com>",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.cjs",
    "build": "tsc -b && vite build",
    "build:core": "node scripts/build-core.mjs",
    "build:core:dev": "node scripts/build-core.mjs --dev",
    "scan:core": "node scripts/scan-core.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win portable",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.jiyili.switch-tool",
    "productName": "技毅力",
    "copyright": "Copyright © 2026 JUZHU",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@serialport/**"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "javascript-obfuscator": "^5.7.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
